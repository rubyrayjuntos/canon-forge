# Optional: Google Gemini API key (required only if using Gemini provider)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override the Gemini model (default: gemini-3-pro-image-preview)
# GEMINI_MODEL=gemini-3-pro-image-preview

# Optional: Server port (default: 3001)
# PORT=3001

# Optional: Generation timeout in milliseconds (default: 120000)
# GENERATION_TIMEOUT_MS=120000

# Optional: Local Stable Diffusion (AUTOMATIC1111) integration
# Set VITE_USE_LOCAL_SD=true to route character/set generation through your local A1111 instance.
# Launch A1111 with: --api --cors-allow-origins "*"
# VITE_USE_LOCAL_SD=true
# LOCAL_SD_URL=http://localhost:7860

# Optional: Venice API key (required only if using Venice provider)
VENICE_API_KEY=your_venice_api_key_here

# Optional: AWS Bedrock credentials + image model config (required for AWS provider)
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key
# AWS_SESSION_TOKEN=optional_session_token
# AWS_REGION=us-east-1
# AWS_BEDROCK_IMAGE_MODEL=amazon.titan-image-generator-v2:0
# AWS_BEDROCK_IMAGE_MODEL_IDS=amazon.titan-image-generator-v2:0

